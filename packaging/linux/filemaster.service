[Unit]
Description=Filemaster
Documentation=https://safing.io
Documentation=https://docs.safing.io
Before=nss-lookup.target network.target shutdown.target
After=systemd-networkd.service
Conflicts=shutdown.target
Wants=nss-lookup.target

[Service]
Type=simple
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=24
LockPersonality=yes
MemoryDenyWriteExecute=yes
MemoryLow=2G
NoNewPrivileges=yes
PrivateTmp=yes
PIDFile=/var/lib/filemaster/core-lock.pid
Environment=LOGLEVEL=info
Environment=FILEMASTER_ARGS=
EnvironmentFile=-/etc/default/filemaster
ProtectSystem=true
ReadWritePaths=/opt/filemaster
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
PrivateDevices=yes
AmbientCapabilities=cap_sys_admin cap_dac_override cap_sys_ptrace
CapabilityBoundingSet=cap_sys_admin cap_dac_override cap_sys_ptrace
# TODO(ppacher): add --disable-software-updates once it's merged and the release process changed.
WorkingDirectory=/var/lib/filemaster
ExecStart=/opt/filemaster/filemaster-core --bin-dir /opt/filemaster --data-dir /var/lib/filemaster -- $FILEMASTER_ARGS

[Install]
WantedBy=multi-user.target
